# Copy this to web/.env.local (gitignored) and fill in the real value.
# Vite only exposes vars prefixed VITE_ to client code, and this one is
# meant to be public — see web/src/clerkConfig.js for why it's still an
# env var rather than a literal.
#
# Get it from the Clerk dashboard: your application -> Configure -> API Keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_aG9wZWZ1bC10ZXJtaXRlLTQyMzYuY2xlcmsuYWNjb3VudHMuZGV2JA
# In production (Cloudflare Pages), set the same variable under
# Workers & Pages -> juke -> Settings -> Environment variables, not here.

# Browser error reporting (web/src/lib/errorMonitoring.js). Leave it unset
# locally unless you are testing the reporter itself - with it set, every
# error you cause while developing lands in the real Sentry inbox. Public by
# design, like the Clerk key: a DSN can only send events.
# VITE_SENTRY_DSN=
#
# In Cloudflare Pages (Production only), set VITE_SENTRY_DSN plus, for
# readable stack traces, SENTRY_AUTH_TOKEN (encrypted), SENTRY_ORG and
# SENTRY_PROJECT. Without the last three the build uploads no source maps
# and behaves exactly as before.
